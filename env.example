# Example environment variables (copy to appropriate .env files per app)
# Do not commit real secrets. This file is safe to commit.

NODE_ENV=development
# PostgreSQL connection string
DATABASE_URL=postgres://user:pass@localhost:5432/webshop
# Or use the remote connection from `baza.md`
# DATABASE_URL=postgres://neondb_owner:password@host:5432/neondb

# Redis URL
REDIS_URL=redis://localhost:6379

# Session secret (random string for signing cookies)
SESSION_SECRET=changeme-session-secret

# MinIO (S3-compatible) storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=changeme-access
MINIO_SECRET_KEY=changeme-secret
MINIO_BUCKET=webshop-media

# Stripe (Standard Connect OAuth)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CLIENT_ID=ca_...
STRIPE_REDIRECT_URI=http://localhost:3000/stripe/callback
STRIPE_PLATFORM_FEE_PERCENT=10

# Frontend and Backend URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=changeme-smtp-password
SMTP_FROM=noreply@example.com

# Cookie settings
COOKIE_NAME=webshop_session
COOKIE_SECURE=false

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Captcha (optional)
CAPTCHA_PROVIDER=recaptcha
# CAPTCHA_SECRET_KEY=
CAPTCHA_MIN_SCORE=0.5

# Vendor product limits
VENDOR_INITIAL_PRODUCT_LIMIT=5

# Identity verification provider (mock for local dev)
IDENTITY_PROVIDER=mock
# IDENTITY_API_KEY=
# IDENTITY_WEBHOOK_SECRET=
IDENTITY_MIN_SCORE=0.6

# Vendor security deposit
SECURITY_DEPOSIT_ENABLED=false
SECURITY_DEPOSIT_AMOUNT_CENTS=5000
SECURITY_DEPOSIT_CURRENCY=EUR

# Require phone verification before vendor application
REQUIRE_PHONE_VERIFICATION=false

# Observability
SENTRY_DSN=
